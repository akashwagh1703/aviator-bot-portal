# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the default model used for chat completions
OPENROUTER_MODEL=openai/gpt-4o-mini

# Public app name shown in the UI
NEXT_PUBLIC_APP_NAME=Kisan Saathi

# TTS: "edge" (default) uses Microsoft Edge neural Indian voices via /api/tts
# Set to "browser" to use only OS SpeechSynthesis voices (offline, lower quality)
TTS_PROVIDER=edge
